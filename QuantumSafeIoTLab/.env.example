# Copy to .env and set the SQL Server 2022 instance/database you actually created.
# DO NOT paste private keys, API keys, passwords, or SQL credentials into public repos.
SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=QuantumSafeIoTLab
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_AUTH=windows
# Set true only for development SQL Server with locally self-signed TLS certificate.
SQL_TRUST_SERVER_CERTIFICATE=false
# Optional exact installed SWI-Prolog binary, if not detected automatically:
# QUANTUMSAFE_SWIPL=C:\Program Files\swipl\bin\swipl.exe
